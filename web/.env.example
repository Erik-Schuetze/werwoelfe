DEEPSEEK_API_KEY=sk-replace-with-your-key
WERWOELFE_DATA_DIR=./data
# Set only when the server runs inside a container with access to the host Docker socket.
WERWOELFE_DOCKER_DATA_DIR=
WERWOELFE_GAME_IMAGE=werwoelfe-game:local
WERWOELFE_MAX_CONCURRENT_RUNS=1
WERWOELFE_MAX_RUN_MINUTES=30

# How a game is started: "docker" for the local daemon, "kubernetes" for an
# in-cluster Job. Leave blank to auto-detect — a Kubernetes service-account
# environment (KUBERNETES_SERVICE_HOST) selects kubernetes, anything else docker.
WERWOELFE_RUNTIME=

# The remaining settings are read only by the kubernetes runtime; they are
# ignored when WERWOELFE_RUNTIME=docker.
# Namespace the game Jobs are created in. Leave blank to use the console pod's
# own namespace (POD_NAMESPACE below).
WERWOELFE_NAMESPACE=
# Injected by the Kubernetes downward API; no value is needed in this file.
# POD_NAMESPACE is the console pod's namespace, and POD_NODE_NAME is the node it
# runs on, which a game Job is pinned to because the shared ReadWriteOnce volume
# can attach to only one node at a time.
POD_NAMESPACE=
POD_NODE_NAME=
# The ReadWriteOnce volume that holds each run's config, events, and results; the
# game Jobs and the console both mount it.
WERWOELFE_PVC_NAME=
# The Secret, and the key within it, that deliver DEEPSEEK_API_KEY straight to
# the game pod. The console never reads the key itself.
WERWOELFE_DEEPSEEK_SECRET=
WERWOELFE_DEEPSEEK_SECRET_KEY=
# Seconds a finished Job and its pod logs are kept before Kubernetes reaps them.
WERWOELFE_JOB_TTL_SECONDS=3600
# How often, in seconds, the console polls a running Job for its state.
WERWOELFE_POLL_SECONDS=5

# Which deployment this process is: "operator" for the private console described
# above, or "viewer" for the read-only public audience instance, which serves only
# /viewer and /api/viewer/* and 404s every other path. Leave blank (or set it to
# "operator") for the console; any other value is an error rather than a silent
# default, so a typo cannot turn a public deployment into an operator. The public
# viewer mounts no data volume, no Docker socket, and no DEEPSEEK_API_KEY.
WERWOELFE_MODE=

# The next four settings are read only when WERWOELFE_MODE=viewer; the operator
# ignores them, because it never calls out to another console.
# The base URL of the operator whose read-only /api/public/* API the viewer proxies.
# Required in viewer mode.
WERWOELFE_OPERATOR_URL=
# Milliseconds the viewer waits for an operator response before giving up and
# reporting the live feed as temporarily unavailable.
WERWOELFE_OPERATOR_TIMEOUT_MS=5000
# Milliseconds between the audience page's polls of /api/viewer/*.
WERWOELFE_VIEWER_POLL_MS=5000
# Milliseconds a proxied operator response is cached and shared across all viewers,
# so a burst of audience traffic collapses into a single operator call.
WERWOELFE_VIEWER_CACHE_MS=1500
